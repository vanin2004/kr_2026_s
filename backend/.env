# PostgreSQL Database Settings
POSTGRES_DB=tutorapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Database Connection URLs
DATABASE_URL=postgres://postgres:password@db:5432/tutorapp

# PostgREST Settings
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=api_user
PGRST_SERVER_PROXY_URI=http://localhost/api/data

# Custom API Settings
SECRET_KEY=1111111111111111111111111111111111111111111111111111111111111111
KEYCLOAK_URL=http://localhost/auth
FCM_KEY_PATH=/app/firebase-key.json

# Web Server
NGINX_PORT=80
EXTERNAL_SERVERNAME=http://104.248.56.85

